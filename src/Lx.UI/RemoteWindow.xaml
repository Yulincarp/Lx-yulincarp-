<Window x:Class="Lx.UI.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lx.UI"
        Title="{ui:T S104}" Width="620" Height="390"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{ui:T S104}" FontSize="22" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,16" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                   Text="{ui:T S105}"/>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="16">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="{ui:T S106}" FontWeight="SemiBold"/>
                <TextBlock Text="{ui:T S107}" Margin="0,14,0,4" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="UrlBox" IsReadOnly="True" Height="30" TextWrapping="NoWrap"/>
                <TextBlock Text="{ui:T S108}" Margin="0,10,0,4" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="TokenBox" IsReadOnly="True" Height="30" FontFamily="Consolas"/>
                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="StartButton" Content="{ui:T S109}" Padding="14,5" Click="Start_Click"/>
                    <Button x:Name="StopButton" Content="{ui:T S110}" Padding="14,5" Margin="8,0,0,0" Click="Stop_Click"/>
                    <Button Content="{ui:T S111}" Padding="14,5" Margin="8,0,0,0" Click="CopyUrl_Click"/>
                    <Button Content="{ui:T S112}" Padding="14,5" Margin="8,0,0,0" Click="CopyToken_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                   Text="{ui:T S113}"/>
    </Grid>
</Window>
