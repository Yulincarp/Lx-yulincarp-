<Window x:Class="Lx.UI.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机遥控" Width="620" Height="390"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="手机遥控" FontSize="22" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,16" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                   Text="手机和电脑连同一个局域网，用手机浏览器打开下面的地址。地址里已经带配对 token。"/>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="16">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="正在启动…" FontWeight="SemiBold"/>
                <TextBlock Text="手机访问地址" Margin="0,14,0,4" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="UrlBox" IsReadOnly="True" Height="30" TextWrapping="NoWrap"/>
                <TextBlock Text="配对 token" Margin="0,10,0,4" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="TokenBox" IsReadOnly="True" Height="30" FontFamily="Consolas"/>
                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="StartButton" Content="启动服务" Padding="14,5" Click="Start_Click"/>
                    <Button x:Name="StopButton" Content="停止服务" Padding="14,5" Margin="8,0,0,0" Click="Stop_Click"/>
                    <Button Content="复制地址" Padding="14,5" Margin="8,0,0,0" Click="CopyUrl_Click"/>
                    <Button Content="复制 token" Padding="14,5" Margin="8,0,0,0" Click="CopyToken_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                   Text="只在局域网使用。Windows 防火墙弹窗时选择“允许访问”；不要把这个地址转发到公网。"/>
    </Grid>
</Window>
