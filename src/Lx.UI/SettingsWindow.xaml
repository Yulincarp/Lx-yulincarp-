<Window x:Class="Lx.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lx yulin carp - 设置" Height="640" Width="680"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="游戏">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="内存分配（MB）" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最小：" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="MinBox" Padding="6,3" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="最大：" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox Grid.Column="3" x:Name="MaxBox" Padding="6,3" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="（256 ~ 65536）" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="Java 版本" FontWeight="Bold" Margin="0,18,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="JavaBox" Padding="6,3"/>
                            <Button Grid.Column="1" Content="浏览…" Padding="14,3" Margin="8,0,0,0" Click="Browse_Click"/>
                        </Grid>

                        <TextBlock Text="JVM 参数" FontWeight="Bold" Margin="0,18,0,8"/>
                        <TextBox x:Name="JvmArgsBox" Height="70" Padding="6,3" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 ToolTip="例如 -XX:+UseG1GC -Dfile.encoding=UTF-8；留空则只用版本默认值"/>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,4,0,0"
                                   Text="空格分隔；带空格的参数用双引号包起来。"/>

                        <TextBlock Text="游戏窗口" FontWeight="Bold" Margin="0,18,0,8"/>
                        <WrapPanel>
                            <TextBlock Text="宽：" VerticalAlignment="Center"/>
                            <TextBox x:Name="WindowWidthBox" Width="80" Padding="6,3" Margin="4,0,16,0"/>
                            <TextBlock Text="高：" VerticalAlignment="Center"/>
                            <TextBox x:Name="WindowHeightBox" Width="80" Padding="6,3" Margin="4,0,16,0"/>
                            <CheckBox x:Name="FullscreenBox" Content="全屏启动" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="下载">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="下载源" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="下载源：" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="SourceBox" Padding="6,3"
                                      SelectionChanged="Source_Changed"/>
                        </Grid>
                        <TextBox x:Name="CustomSourceBox" Margin="110,8,0,0" Padding="6,3" IsEnabled="False"
                                 ToolTip="兼容 BMCLAPI 路径的镜像根地址，例如 https://bmclapi2.bangbang93.com"/>

                        <TextBlock Text="并发数" FontWeight="Bold" Margin="0,18,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="ConcurrencyBox" Width="80" Padding="6,3"/>
                            <TextBlock Text="（1 ~ 16，默认 8）" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="代理" FontWeight="Bold" Margin="0,18,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="模式：" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="ProxyModeBox" Padding="6,3"
                                      SelectionChanged="Proxy_Changed"/>
                        </Grid>
                        <TextBox x:Name="ProxyUrlBox" Margin="110,8,0,0" Padding="6,3" IsEnabled="False"
                                 ToolTip="http://127.0.0.1:7890"/>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="代理只作用于启动器下载（游戏本体/库/assets）；系统模式使用 Windows 设置。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="启动器">
                <StackPanel Margin="14">
                    <TextBlock Text="语言" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="LanguageBox" Width="180" HorizontalAlignment="Left" Padding="6,3">
                        <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="目前覆盖主界面的导航、页面标题和主要按钮；其余页面文案仍是中文。"/>

                    <TextBlock Text="更新通道" FontWeight="Bold" Margin="0,18,0,8"/>
                    <ComboBox x:Name="UpdateChannelBox" Width="220" HorizontalAlignment="Left" Padding="6,3">
                        <ComboBoxItem Content="stable（update.json）" Tag="stable"/>
                        <ComboBoxItem Content="beta（update-beta.json）" Tag="beta"/>
                    </ComboBox>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="发布版把对应通道的 update.json 放到数据目录，或在 LX_UPDATE_URL 指定。"/>

                    <TextBlock Text="隐私与诊断" FontWeight="Bold" Margin="0,18,0,8"/>
                    <CheckBox x:Name="TelemetryBox" Content="崩溃时上传诊断报告（默认关闭）"
                              ToolTip="勾选后才会发送；报告内容见下方说明"/>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="包含：启动器/Windows/.NET 版本、异常类型与堆栈、最近约 80 行日志（token 与密钥自动打码）。不包含账号密码、存档、mods。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="上传地址：" VerticalAlignment="Center"/>
                        <TextBox x:Name="CrashUrlBox" Width="300" Padding="6,3" Margin="6,0,8,0"
                                 ToolTip="留空则只保存在本地 logs\crash\；也可以由环境变量 LX_CRASH_ENDPOINT 覆盖"/>
                        <Button Content="隐私说明" Padding="10,3" Click="Privacy_Click"/>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="不填地址时，崩溃报告只写到 logs\crash\，不会联网。"/> 

                    <TextBlock Text="语言 / 主题" FontWeight="Bold" Margin="0,18,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="主题：" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThemeBox" Width="150" Padding="6,3" Margin="6,0,0,0">
                            <ComboBoxItem Content="浅色" Tag="light"/>
                            <ComboBoxItem Content="深色" Tag="dark"/>
                            <ComboBoxItem Content="跟随系统" Tag="system"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="语言当前固定简体中文。深色主题只覆盖窗口/面板/主要文本，复杂控件模板后续再细化。"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="关于">
                <StackPanel Margin="14">
                    <TextBlock Text="Lx yulin carp" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="AboutVersionText" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="AboutRuntimeText" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    <TextBlock Text="数据目录" FontWeight="Bold" Margin="0,18,0,6"/>
                    <TextBox x:Name="AboutDataDirText" IsReadOnly="True" Padding="6,3"/>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,18,0,0"
                               Text="自更新：设置窗口底部「检查更新」。更新包会校验 sha256，失败自动回滚。"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" x:Name="HintText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                   VerticalAlignment="Top" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="UpdateButton" Content="检查更新" Padding="12,5" Margin="0,0,10,0"
                    Click="CheckUpdate_Click"
                    ToolTip="检查 update.json 里是否有新版本"/>
            <Button Content="保存" Padding="20,5" Click="Save_Click"/>
            <Button Content="取消" Padding="20,5" Margin="10,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
