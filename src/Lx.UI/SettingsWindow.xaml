<Window x:Class="Lx.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lx.UI"
        Title="{ui:T S116}" Height="640" Width="680"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="{ui:T S117}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{ui:T S118}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{ui:T S119}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="MinBox" Padding="6,3" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{ui:T S120}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox Grid.Column="3" x:Name="MaxBox" Padding="6,3" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="（256 ~ 65536）" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{ui:T S121}" FontWeight="Bold" Margin="0,18,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="JavaBox" Padding="6,3"/>
                            <Button Grid.Column="1" Content="{ui:T S122}" Padding="14,3" Margin="8,0,0,0" Click="Browse_Click"/>
                        </Grid>

                        <TextBlock Text="{ui:T S123}" FontWeight="Bold" Margin="0,18,0,8"/>
                        <TextBox x:Name="JvmArgsBox" Height="70" Padding="6,3" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 ToolTip="{ui:T S124}"/>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,4,0,0"
                                   Text="{ui:T S125}"/>

                        <TextBlock Text="{ui:T S126}" FontWeight="Bold" Margin="0,18,0,8"/>
                        <WrapPanel>
                            <TextBlock Text="{ui:T S127}" VerticalAlignment="Center"/>
                            <TextBox x:Name="WindowWidthBox" Width="80" Padding="6,3" Margin="4,0,16,0"/>
                            <TextBlock Text="{ui:T S128}" VerticalAlignment="Center"/>
                            <TextBox x:Name="WindowHeightBox" Width="80" Padding="6,3" Margin="4,0,16,0"/>
                            <CheckBox x:Name="FullscreenBox" Content="{ui:T S129}" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{ui:T S130}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{ui:T S131}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{ui:T S132}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="SourceBox" Padding="6,3"
                                      SelectionChanged="Source_Changed"/>
                        </Grid>
                        <TextBox x:Name="CustomSourceBox" Margin="110,8,0,0" Padding="6,3" IsEnabled="False"
                                 ToolTip="{ui:T S133}"/>

                        <TextBlock Text="{ui:T S134}" FontWeight="Bold" Margin="0,18,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="ConcurrencyBox" Width="80" Padding="6,3"/>
                            <TextBlock Text="{ui:T S135}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="{ui:T S136}" FontWeight="Bold" Margin="0,18,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{ui:T S137}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="ProxyModeBox" Padding="6,3"
                                      SelectionChanged="Proxy_Changed"/>
                        </Grid>
                        <TextBox x:Name="ProxyUrlBox" Margin="110,8,0,0" Padding="6,3" IsEnabled="False"
                                 ToolTip="http://127.0.0.1:7890"/>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="{ui:T S138}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{ui:T S139}">
                <StackPanel Margin="14">
                    <TextBlock Text="{ui:T S140}" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="LanguageBox" Width="180" HorizontalAlignment="Left" Padding="6,3">
                        <ComboBoxItem Content="{ui:T S141}" Tag="zh-CN"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{ui:T S142}"/>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{ui:T S185}"/>

                    <TextBlock Text="{ui:T S143}" FontWeight="Bold" Margin="0,18,0,8"/>
                    <ComboBox x:Name="UpdateChannelBox" Width="220" HorizontalAlignment="Left" Padding="6,3">
                        <ComboBoxItem Content="stable（update.json）" Tag="stable"/>
                        <ComboBoxItem Content="beta（update-beta.json）" Tag="beta"/>
                    </ComboBox>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{ui:T S144}"/>

                    <TextBlock Text="{ui:T S145}" FontWeight="Bold" Margin="0,18,0,8"/>
                    <CheckBox x:Name="TelemetryBox" Content="{ui:T S146}"
                              ToolTip="{ui:T S147}"/>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{ui:T S148}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{ui:T S149}" VerticalAlignment="Center"/>
                        <TextBox x:Name="CrashUrlBox" Width="300" Padding="6,3" Margin="6,0,8,0"
                                 ToolTip="{ui:T S150}"/>
                        <Button Content="{ui:T S151}" Padding="10,3" Click="Privacy_Click"/>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{ui:T S152}"/> 

                    <TextBlock Text="{ui:T S153}" FontWeight="Bold" Margin="0,18,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{ui:T S154}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThemeBox" Width="150" Padding="6,3" Margin="6,0,0,0">
                            <ComboBoxItem Content="{ui:T S155}" Tag="light"/>
                            <ComboBoxItem Content="{ui:T S156}" Tag="dark"/>
                            <ComboBoxItem Content="{ui:T S157}" Tag="system"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{ui:T S158}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="{ui:T S159}">
                <StackPanel Margin="14">
                    <TextBlock Text="Lx yulin carp" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="AboutVersionText" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="AboutRuntimeText" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    <TextBlock Text="{ui:T S160}" FontWeight="Bold" Margin="0,18,0,6"/>
                    <TextBox x:Name="AboutDataDirText" IsReadOnly="True" Padding="6,3"/>
                    <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,18,0,0"
                               Text="{ui:T S161}"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" x:Name="HintText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                   VerticalAlignment="Top" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="UpdateButton" Content="{ui:T S162}" Padding="12,5" Margin="0,0,10,0"
                    Click="CheckUpdate_Click"
                    ToolTip="{ui:T S163}"/>
            <Button Content="{ui:T S164}" Padding="20,5" Click="Save_Click"/>
            <Button Content="{ui:T S003}" Padding="20,5" Margin="10,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
