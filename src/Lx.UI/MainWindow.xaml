<Window x:Class="Lx.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lx yulin carp" Height="720" Width="1260" FontSize="13" Closing="MainWindow_Closing"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,14,0">
            <TextBlock Text="Lx yulin carp" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SidebarVersionText" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,18"/>
            <Button Content="首页" Click="Home_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button Content="版本" Click="VersionPage_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button Content="实例" Click="InstancePage_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button Content="资源" Click="ResourcePage_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button Content="账号" Click="AccountPage_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button Content="设置" Click="SettingsPage_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button Content="日志" Click="LogPage_Click" HorizontalContentAlignment="Left" Padding="12,8"/>
            <TextBlock Text="首页选实例，底部启动；版本/实例/资源/账号分页管理。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,22,0,0" FontSize="11"/>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid x:Name="HomeView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="首页" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="选一个实例，然后点底部「启动游戏」" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="实例" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedItem.Name, ElementName=InstancesList}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="版本" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedItem.Id, ElementName=VersionBox}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="加载器" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedItem.Content, ElementName=LoaderBox}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="账号" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedItem.Name, ElementName=AccountBox}" FontSize="16"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <GroupBox Grid.Row="2" Header="实例" Margin="0,16,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HomeInstances">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="HomeInstance_Click" Width="180" Height="72"
                                                Margin="0,0,10,10" Padding="12,8" HorizontalContentAlignment="Stretch">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding VersionId}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Loader}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>

                <Grid x:Name="VersionView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="版本与加载器" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="先选 Minecraft 版本，再决定原版/Fabric/Forge/NeoForge" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                <TextBlock Text="版本" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="VersionBox" Width="160" VerticalAlignment="Center"
                                          SelectionChanged="Version_Changed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                <TextBlock Text="加载器" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="LoaderBox" Width="95" VerticalAlignment="Center" SelectedIndex="0"
                                          SelectionChanged="Loader_Changed">
                                    <ComboBoxItem Content="原版"/>
                                    <ComboBoxItem Content="Fabric"/>
                                    <ComboBoxItem Content="Forge"/>
                                    <ComboBoxItem Content="NeoForge"/>
                                </ComboBox>
                                <ComboBox x:Name="LoaderVersionBox" Width="170" Margin="6,0,0,0" VerticalAlignment="Center"
                                          IsEnabled="False" DisplayMemberPath="Display"
                                          ToolTip="加载器版本；Fabric 启动时自动安装，Forge/NeoForge 先点「安装」"/>
                                <Button x:Name="InstallLoaderButton" Content="安装" Margin="6,0,0,0" Padding="10,3"
                                        IsEnabled="False" Click="InstallLoader_Click"
                                        ToolTip="Forge/NeoForge 专用：先安装，再把版本切到生成的条目；Fabric 在启动时自动安装"/>
                                <Button x:Name="CancelLoaderButton" Content="取消安装" Margin="6,0,0,0" Padding="10,3"
                                        IsEnabled="False" Click="CancelLoader_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Expander x:Name="LoaderInstallExpander" Header="安装日志" IsExpanded="False">
                            <TextBox x:Name="LoaderInstallLog" Height="150" IsReadOnly="True"
                                     Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     TextWrapping="NoWrap"/>
                        </Expander>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Fabric 选版本即可，启动时自动合并；Forge/NeoForge 选版本后点「安装」，安装完版本会自动切到生成的条目。安装器运行中可以取消，已生成的部分文件会保留，下次安装会复用。启动按钮在底部。"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="InstanceView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="实例" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="每个实例有自己的存档、mods、设置" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Margin="0,16,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBox x:Name="NewInstanceName" Height="28" Margin="0,0,0,8" ToolTip="留空则自动用版本名"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="新建" Click="CreateInstance_Click" Padding="14,4" Margin="0,0,8,0"/>
                                    <Button Content="删除" Click="DeleteInstance_Click" Padding="14,4" Margin="0,0,8,0"/>
                                    <Button Content="导入" Click="ImportPack_Click" Padding="14,4" Margin="0,0,8,0"/>
                                    <Button x:Name="UpdatePackButton" Content="更新包" Click="UpdatePack_Click" Padding="14,4"
                                            ToolTip="只有用「导入」创建的整合包实例才能更新"/>
                                </WrapPanel>
                            </StackPanel>
                            <ListBox x:Name="InstancesList" SelectionChanged="Instances_SelectionChanged" DisplayMemberPath="Name"/>
                        </DockPanel>
                    </GroupBox>
                </Grid>

                <Grid x:Name="ResourceView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="资源" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Modrinth 搜索安装 + 当前实例的本地 mods" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="Modrinth 在线安装" Margin="0,16,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <ComboBox x:Name="ModSourceBox" Width="120" Height="28" Margin="0,0,8,6"
                                          SelectedIndex="0" SelectionChanged="ModSource_Changed"
                                          ToolTip="选择搜索源">
                                    <ComboBoxItem Content="Modrinth"/>
                                    <ComboBoxItem Content="CurseForge"/>
                                </ComboBox>
                                <TextBox x:Name="ModrinthSearchBox" Width="300" Height="28" Margin="0,0,8,6"
                                         KeyDown="ModrinthSearchBox_KeyDown"
                                         ToolTip="例如 sodium、iris、fabric api；回车搜索"/>
                                <Button x:Name="ModrinthSearchButton" Content="搜索" Padding="14,4" Margin="0,0,8,6"
                                        Click="ModrinthSearch_Click"/>
                                <Button x:Name="ModrinthInstallButton" Content="安装选中" Padding="14,4" Margin="0,0,8,6"
                                        Click="ModrinthInstall_Click"/>
                                <TextBlock x:Name="ModrinthStatusText" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Margin="0,0,12,6" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ModrinthContextText" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                            </WrapPanel>
                            <ListBox x:Name="ModrinthResults" Height="150" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11">
                                                <Run Text="{Binding Author}"/>
                                                <Run Text=" · 下载 "/>
                                                <Run Text="{Binding Downloads}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Row="2" Margin="0,12,0,8">
                        <TextBox x:Name="ModSearch" Height="28" Margin="0,0,0,6" TextChanged="ModSearch_Changed"
                                 ToolTip="按名字 / 文件名 / mod id 过滤"/>
                        <ComboBox x:Name="ModSort" Height="26" Margin="0,0,0,6" SelectedIndex="0"
                                  SelectionChanged="ModSort_Changed">
                            <ComboBoxItem Content="按名字排序"/>
                            <ComboBoxItem Content="按文件名排序"/>
                            <ComboBoxItem Content="启用的在前"/>
                        </ComboBox>
                        <WrapPanel>
                            <Button Content="刷新" Click="RefreshMods_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button Content="添加" Click="AddMod_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button Content="删除" Click="RemoveMod_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button x:Name="CheckUpdatesButton" Content="检查/更新" Click="CheckUpdates_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button x:Name="ScanConflictsButton" Content="扫描冲突" Click="ScanConflicts_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button Content="备份目录" Click="OpenModBackup_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button Content="OptiFabric" Click="InstallOptiFabric_Click" Padding="10,3"/>
                        </WrapPanel>
                        <TextBlock x:Name="ModsPathText" Text="{Binding ModsDirectory}" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <ListView Grid.Row="3" x:Name="ModsList" BorderThickness="0" ItemsSource="{Binding Mods}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Enabled, Mode=OneTime}"
                                              Click="ModCheck_Click" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" Width="180" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Version}" Width="80" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid x:Name="AccountView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="账号" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="离线 / 外置（Yggdrasil）/ 微软正版" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                    <TextBlock Text="账号" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="AccountBox" Width="170" VerticalAlignment="Center" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                    <TextBlock Text="离线名" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="NameBox" Width="100" VerticalAlignment="Center"/>
                                    <Button Content="添加" Margin="8,0,0,0" Padding="10,3" Click="AddAccount_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="登录" Padding="10,3" Click="Login_Click"/>
                                    <Button Content="正版登录" Margin="8,0,0,0" Padding="10,3" Click="MicrosoftLogin_Click"/>
                                    <Button Content="切换角色" Margin="8,0,0,0" Padding="10,3" Click="SwitchRole_Click"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="正版登录使用微软 device code；外置登录使用 LittleSkin 等 Yggdrasil 站点。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="设置" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="内存 / Java / 下载源 / 启动器更新" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SettingsSummaryText" FontSize="14" TextWrapping="Wrap" Text="{Binding Summary}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DataDirText" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding DataDirectory}"/>
                                <Button Grid.Column="1" Content="更改数据目录…" Margin="10,0,0,0" Padding="10,3"
                                        Click="ChangeDataDirectory_Click"
                                        ToolTip="把当前全部数据复制到新目录，并切换启动器数据位置；旧目录保留"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="打开设置…" Padding="14,5" Click="Settings_Click"/>
                                <Button Content="手机遥控…" Margin="10,0,0,0" Padding="14,5" Click="Remote_Click"
                                        ToolTip="手机和电脑同一局域网时，用手机浏览器遥控启动"/>
                                <Button Content="从旧版导入数据…" Margin="10,0,0,0" Padding="14,5"
                                        Click="MigrateOldData_Click"
                                        ToolTip="把旧版 minecraft 或 %APPDATA%\Lx 的数据复制到当前数据目录；不覆盖已有文件"/>
                            </StackPanel>
                            <Separator Margin="0,16,0,10"/>
                            <TextBlock Text="CurseForge API Key" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="CurseForgeKeyBox" Width="460" Height="28" Margin="0,8,0,0"
                                         HorizontalAlignment="Left" ToolTip="从 CurseForge 开发者控制台申请"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="保存 Key" Padding="14,4" Click="SaveCurseForgeKey_Click"/>
                                <TextBlock x:Name="CurseForgeKeyStatus" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Text="{Binding CurseForgeKeyStatus}"
                                           Margin="12,0,0,0"/>
                            </WrapPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                                       Text="Key 用 DPAPI 加密保存在数据目录；不填 Key 时只能用 Modrinth。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="2" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,14,0,0"
                               Text="自更新的「检查更新」在设置窗口里；发布版才会真正替换文件。"/>
                </Grid>

                <Grid x:Name="LogView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="日志" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="启动器日志；底部可复制失败清单/打开日志目录/校验文件" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" Margin="0,16,0,0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"/>
                </Grid>
            </Grid>

            <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                <Button x:Name="LaunchButton" Content="启动游戏" Padding="22,6" Margin="0,0,12,6" Click="Launch_Click"/>
                <ProgressBar x:Name="Progress" Width="240" Height="18" Margin="0,0,12,6" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Margin="0,0,12,6" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                <Button x:Name="CopyFailuresButton" Content="复制失败清单" Padding="10,3" Margin="0,0,8,6"
                        IsEnabled="False" Click="CopyFailures_Click"/>
                <Button Content="打开日志" Padding="10,3" Margin="0,0,8,6" Click="OpenLogs_Click"/>
                <Button x:Name="RepairButton" Content="校验/修复" Padding="10,3" Margin="0,0,0,6"
                        Click="Repair_Click" ToolTip="按 sha1 重新检查并补齐当前版本/实例的文件"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
