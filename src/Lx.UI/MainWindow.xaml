<Window x:Class="Lx.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lx.UI"
        Title="Lx yulin carp" Height="720" Width="1260" FontSize="13" Closing="MainWindow_Closing" PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="14" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,14,0">
            <TextBlock Text="Lx yulin carp" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SidebarVersionText" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,18"/>
            <Button TabIndex="1" Content="{ui:T S181}" Click="Home_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button TabIndex="2" Content="{ui:T S025}" Click="VersionPage_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button TabIndex="3" Content="{ui:T S024}" Click="InstancePage_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button TabIndex="4" Content="{ui:T S182}" Click="ResourcePage_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button TabIndex="5" Content="{ui:T S027}" Click="AccountPage_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button TabIndex="6" Content="{ui:T S184}" Click="SettingsPage_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,6"/>
            <Button TabIndex="7" Content="{ui:T S183}" Click="LogPage_Click" HorizontalContentAlignment="Left" Padding="12,8"/>
            <TextBlock Text="{ui:T S022}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,22,0,0" FontSize="11"/>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid x:Name="HomeView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{ui:T S181}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{ui:T S023}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{ui:T S024}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedItem.Name, ElementName=InstancesList}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{ui:T S025}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedItem.Id, ElementName=VersionBox}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{ui:T S026}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedItem.Content, ElementName=LoaderBox}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{ui:T S027}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedItem.Name, ElementName=AccountBox}" FontSize="16"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <GroupBox Grid.Row="2" Header="{ui:T S024}" Margin="0,16,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="HomeInstances">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="HomeInstance_Click" Width="180" Height="72"
                                                Margin="0,0,10,10" Padding="12,8" HorizontalContentAlignment="Stretch">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding VersionId}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Loader}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>

                <Grid x:Name="VersionView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{ui:T S176}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{ui:T S028}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                <TextBlock Text="{ui:T S025}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="VersionSearchBox" Width="110" Height="26" Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="VersionSearch_Changed"
                                         ToolTip="{ui:T S029}"/>
                                <ComboBox x:Name="VersionBox" Width="160" VerticalAlignment="Center"
                                          ToolTip="{ui:T S030}"
                                          SelectionChanged="Version_Changed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                <TextBlock Text="{ui:T S026}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="LoaderBox" Width="95" VerticalAlignment="Center" SelectedIndex="0"
                                          SelectionChanged="Loader_Changed">
                                    <ComboBoxItem Content="{ui:T S031}"/>
                                    <ComboBoxItem Content="Fabric"/>
                                    <ComboBoxItem Content="Forge"/>
                                    <ComboBoxItem Content="NeoForge"/>
                                </ComboBox>
                                <ComboBox x:Name="LoaderVersionBox" Width="170" Margin="6,0,0,0" VerticalAlignment="Center"
                                          IsEnabled="False" DisplayMemberPath="Display"
                                          ToolTip="{ui:T S032}"/>
                                <Button x:Name="InstallLoaderButton" Content="{ui:T S033}" Margin="6,0,0,0" Padding="10,3"
                                        IsEnabled="False" Click="InstallLoader_Click"
                                        ToolTip="{ui:T S034}"/>
                                <Button x:Name="CancelLoaderButton" Content="{ui:T S035}" Margin="6,0,0,0" Padding="10,3"
                                        IsEnabled="False" Click="CancelLoader_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Expander x:Name="LoaderInstallExpander" Header="{ui:T S036}" IsExpanded="False">
                            <TextBox x:Name="LoaderInstallLog" Height="150" IsReadOnly="True"
                                     Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     TextWrapping="NoWrap"/>
                        </Expander>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="{ui:T S037}"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="InstanceView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{ui:T S024}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{ui:T S038}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Margin="0,16,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBox x:Name="NewInstanceName" Height="28" Margin="0,0,0,8" ToolTip="{ui:T S039}"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="{ui:T S040}" Click="CreateInstance_Click" Padding="14,4" Margin="0,0,8,0"/>
                                    <Button Content="{ui:T S041}" Click="RenameInstance_Click" Padding="14,4" Margin="0,0,8,0"
                                            ToolTip="{ui:T S042}"/>
                                    <Button Content="{ui:T S043}" Click="CopyInstance_Click" Padding="14,4" Margin="0,0,8,0"
                                            ToolTip="{ui:T S044}"/>
                                    <Button Content="{ui:T S045}" Click="DeleteInstance_Click" Padding="14,4" Margin="0,0,8,0"
                                            ToolTip="{ui:T S046}"/>
                                    <Button Content="{ui:T S047}" Click="OpenInstanceDir_Click" Padding="14,4" Margin="0,0,8,0"/>
                                    <Button Content="{ui:T S048}" Click="ImportPack_Click" Padding="14,4" Margin="0,0,8,0"/>
                                    <Button x:Name="UpdatePackButton" Content="{ui:T S049}" Click="UpdatePack_Click" Padding="14,4"
                                            ToolTip="{ui:T S050}"/>
                                </WrapPanel>
                            </StackPanel>
                            <ListBox x:Name="InstancesList" SelectionChanged="Instances_SelectionChanged" DisplayMemberPath="Name"/>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="{ui:T S051}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{ui:T S052}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="PackSyncUrlBox" Height="28"
                                         ToolTip="{ui:T S053}"/>
                            </DockPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="{ui:T S054}" Click="ExportPack_Click" Padding="14,4" Margin="0,0,8,0"
                                        ToolTip="{ui:T S055}"/>
                                <Button x:Name="SyncPackButton" Content="{ui:T S056}" Click="SyncPack_Click" Padding="14,4" Margin="0,0,8,0"
                                        ToolTip="{ui:T S057}"/>
                                <Button Content="{ui:T S058}" Click="RollbackPack_Click" Padding="14,4" Margin="0,0,8,0"
                                        ToolTip="{ui:T S059}"/>
                                <Button Content="{ui:T S060}" Click="ShowSnapshots_Click" Padding="14,4"/>
                            </WrapPanel>
                            <DockPanel>
                                <TextBlock Text="{ui:T S061}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <Button Content="{ui:T S062}" Click="JoinServer_Click" Padding="14,4" DockPanel.Dock="Right" Margin="8,0,0,0"
                                        ToolTip="{ui:T S063}"/>
                                <TextBox x:Name="ServerAddressBox" Height="28" ToolTip="{ui:T S064}"/>
                            </DockPanel>
                            <TextBlock x:Name="SyncStatusText" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="{ui:T S065}"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <Grid x:Name="ResourceView" Visibility="Collapsed"
                      AllowDrop="True" DragOver="ResourceView_DragOver" Drop="ResourceView_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{ui:T S182}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{ui:T S066}"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="{ui:T S067}" Margin="0,16,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <ComboBox x:Name="ModSourceBox" Width="120" Height="28" Margin="0,0,8,6"
                                          SelectedIndex="0" SelectionChanged="ModSource_Changed"
                                          ToolTip="{ui:T S068}">
                                    <ComboBoxItem Content="Modrinth"/>
                                    <ComboBoxItem Content="CurseForge"/>
                                </ComboBox>
                                <TextBox x:Name="ModrinthSearchBox" Width="300" Height="28" Margin="0,0,8,6"
                                         KeyDown="ModrinthSearchBox_KeyDown"
                                         ToolTip="{ui:T S069}"/>
                                <Button x:Name="ModrinthSearchButton" Content="{ui:T S070}" Padding="14,4" Margin="0,0,8,6"
                                        Click="ModrinthSearch_Click"/>
                                <Button x:Name="ModrinthInstallButton" Content="{ui:T S071}" Padding="14,4" Margin="0,0,8,6"
                                        Click="ModrinthInstall_Click"/>
                                <TextBlock x:Name="ModrinthStatusText" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Margin="0,0,12,6" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ModrinthContextText" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                            </WrapPanel>
                            <ListBox x:Name="ModrinthResults" Height="150" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11">
                                                <Run Text="{Binding Author}"/>
                                                <Run Text="{ui:T S072}"/>
                                                <Run Text="{Binding Downloads}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Row="2" Margin="0,12,0,8">
                        <TextBox x:Name="ModSearch" Height="28" Margin="0,0,0,6" TextChanged="ModSearch_Changed"
                                 ToolTip="{ui:T S073}"/>
                        <ComboBox x:Name="ModSort" Height="26" Margin="0,0,0,6" SelectedIndex="0"
                                  SelectionChanged="ModSort_Changed">
                            <ComboBoxItem Content="{ui:T S074}"/>
                            <ComboBoxItem Content="{ui:T S075}"/>
                            <ComboBoxItem Content="{ui:T S076}"/>
                        </ComboBox>
                        <WrapPanel>
                            <Button Content="{ui:T S077}" Click="RefreshMods_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button Content="{ui:T S078}" Click="AddMod_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button Content="{ui:T S045}" Click="RemoveMod_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button x:Name="CheckUpdatesButton" Content="{ui:T S079}" Click="CheckUpdates_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button x:Name="ScanConflictsButton" Content="{ui:T S080}" Click="ScanConflicts_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button Content="{ui:T S081}" Click="OpenModBackup_Click" Padding="10,3" Margin="0,0,8,0"/>
                            <Button Content="OptiFabric" Click="InstallOptiFabric_Click" Padding="10,3"/>
                        </WrapPanel>
                        <TextBlock x:Name="ModsPathText" Text="{Binding ModsDirectory}" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <ListView Grid.Row="3" x:Name="ModsList" BorderThickness="0" ItemsSource="{Binding Mods}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Enabled, Mode=OneTime}"
                                              Click="ModCheck_Click" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" Width="180" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Version}" Width="80" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid x:Name="AccountView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{ui:T S027}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{ui:T S082}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                    <TextBlock Text="{ui:T S027}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="AccountBox" Width="170" VerticalAlignment="Center" DisplayMemberPath="Name"
                                              SelectionChanged="AccountBox_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                    <TextBlock Text="{ui:T S083}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="NameBox" Width="100" VerticalAlignment="Center"/>
                                    <Button Content="{ui:T S078}" Margin="8,0,0,0" Padding="10,3" Click="AddAccount_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{ui:T S020}" Padding="10,3" Click="Login_Click"/>
                                    <Button Content="{ui:T S084}" Margin="8,0,0,0" Padding="10,3" Click="MicrosoftLogin_Click"/>
                                    <Button Content="{ui:T S085}" Margin="8,0,0,0" Padding="10,3" Click="SwitchRole_Click"/>
                                    <Button Content="{ui:T S086}" Margin="8,0,0,0" Padding="10,3" Click="PickSkin_Click"
                                            ToolTip="{ui:T S087}"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{ui:T S088}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="64" Height="64" CornerRadius="6" Margin="0,0,14,0" VerticalAlignment="Top"
                                        Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource TextSecondary}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock x:Name="AvatarLetter" FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="AccountAvatar" Width="56" Height="56" Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="AccountDetailText" Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{ui:T S184}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{ui:T S089}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SettingsSummaryText" FontSize="14" TextWrapping="Wrap" Text="{Binding Summary}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DataDirText" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding DataDirectory}"/>
                                <Button Grid.Column="1" Content="{ui:T S178}" Margin="10,0,0,0" Padding="10,3"
                                        Click="ChangeDataDirectory_Click"
                                        ToolTip="{ui:T S090}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="{ui:T S177}" Padding="14,5" Click="Settings_Click"/>
                                <Button Content="{ui:T S180}" Margin="10,0,0,0" Padding="14,5" Click="Remote_Click"
                                        ToolTip="{ui:T S091}"/>
                                <Button Content="{ui:T S179}" Margin="10,0,0,0" Padding="14,5"
                                        Click="MigrateOldData_Click"
                                        ToolTip="{ui:T S092}"/>
                            </StackPanel>
                            <Separator Margin="0,16,0,10"/>
                            <TextBlock Text="CurseForge API Key" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="CurseForgeKeyBox" Width="460" Height="28" Margin="0,8,0,0"
                                         HorizontalAlignment="Left" ToolTip="{ui:T S093}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="{ui:T S094}" Padding="14,4" Click="SaveCurseForgeKey_Click"/>
                                <TextBlock x:Name="CurseForgeKeyStatus" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Text="{Binding CurseForgeKeyStatus}"
                                           Margin="12,0,0,0"/>
                            </WrapPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                                       Text="{ui:T S095}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="2" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,14,0,0"
                               Text="{ui:T S096}"/>
                </Grid>

                <Grid x:Name="LogView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{ui:T S183}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{ui:T S097}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" Margin="0,16,0,0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"/>
                </Grid>
            </Grid>

            <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                <Button x:Name="LaunchButton" Content="{ui:T S172}" Padding="22,6" Margin="0,0,12,6" Click="Launch_Click"/>
                <ProgressBar x:Name="Progress" Width="240" Height="18" Margin="0,0,12,6" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Margin="0,0,12,6" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                <Button x:Name="CopyFailuresButton" Content="{ui:T S175}" Padding="10,3" Margin="0,0,8,6"
                        IsEnabled="False" Click="CopyFailures_Click"/>
                <Button Content="{ui:T S174}" Padding="10,3" Margin="0,0,8,6" Click="OpenLogs_Click"/>
                <Button x:Name="RepairButton" Content="{ui:T S173}" Padding="10,3" Margin="0,0,0,6"
                        Click="Repair_Click" ToolTip="{ui:T S098}"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
