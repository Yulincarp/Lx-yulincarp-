<Window x:Class="Lx.UI.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正版登录（Microsoft）" Height="380" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Azure 应用（客户端）ID" Margin="0,0,0,4"/>
        <TextBox Grid.Row="0" x:Name="ClientIdBox" Margin="0,22,0,0" Height="26"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="StartButton" Content="开始登录" Padding="18,5" Click="Start_Click"/>
            <Button Content="打开浏览器" Padding="18,5" Margin="10,0,0,0" Click="OpenBrowser_Click"/>
            <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <TextBox Grid.Row="2" x:Name="OutputBox" Margin="0,14,0,0" Height="90" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="提示：没有 Azure client id 时会报 AADSTS700038；注册应用后把「应用程序(客户端) ID」填到上面。"/>
    </Grid>
</Window>
