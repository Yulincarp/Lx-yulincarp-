<Window x:Class="Lx.UI.RoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lx.UI"
        Title="{ui:T S085}" Height="320" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{ui:T S114}" TextWrapping="Wrap"/>
        <ListBox Grid.Row="1" x:Name="RoleList" Margin="0,12,0,12" DisplayMemberPath="Name"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="{ui:T S115}" Padding="18,5" Click="Ok_Click"/>
            <Button Content="{ui:T S003}" Padding="18,5" Margin="10,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
