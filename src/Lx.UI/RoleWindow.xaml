<Window x:Class="Lx.UI.RoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="切换角色" Height="320" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择要使用的角色（会重新签发该角色的 token）：" TextWrapping="Wrap"/>
        <ListBox Grid.Row="1" x:Name="RoleList" Margin="0,12,0,12" DisplayMemberPath="Name"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="切换" Padding="18,5" Click="Ok_Click"/>
            <Button Content="取消" Padding="18,5" Margin="10,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
