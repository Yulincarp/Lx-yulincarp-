<Window x:Class="Lx.UI.InstanceNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lx.UI"
        Title="{ui:T S014}" Height="200" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptText" TextWrapping="Wrap"/>
        <TextBox Grid.Row="1" x:Name="NameBox" Height="26" Margin="0,12,0,0"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{ui:T S015}" Padding="16,5" Click="Ok_Click" IsDefault="True"/>
            <Button Content="{ui:T S003}" Padding="16,5" Margin="10,0,0,0" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
